# Copy this file to .env and replace the values.
# Gmail example: use an App Password, not your normal Gmail password.

RENTAL_SECRET_KEY=change-this-to-a-long-random-secret

# First run only: creates the owner login (email = RENTAL_OWNER_EMAIL below).
# Change your password from the dashboard afterwards.
RENTAL_OWNER_PASSWORD=change-this-owner-password

# Set to true only on your own machine. Never in production (enables the debugger).
RENTAL_DEBUG=false

RENTAL_OWNER_EMAIL=your-email@example.com
RENTAL_FROM_EMAIL=your-email@example.com
RENTAL_SMTP_HOST=smtp.gmail.com
RENTAL_SMTP_PORT=587
RENTAL_SMTP_USE_TLS=true
RENTAL_SMTP_USERNAME=your-email@example.com
RENTAL_SMTP_PASSWORD=your-email-app-password
