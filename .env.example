# Copy this file to .env and replace the values.
# Gmail example: use an App Password, not your normal Gmail password.

KAYAK_SECRET_KEY=change-this-to-a-long-random-secret

# First run only: creates the owner login (email = KAYAK_OWNER_EMAIL below).
# Change your password from the dashboard afterwards.
KAYAK_OWNER_PASSWORD=change-this-owner-password

# Set to true only on your own machine. Never in production (enables the debugger).
KAYAK_DEBUG=false

KAYAK_OWNER_EMAIL=your-email@example.com
KAYAK_FROM_EMAIL=your-email@example.com
KAYAK_SMTP_HOST=smtp.gmail.com
KAYAK_SMTP_PORT=587
KAYAK_SMTP_USE_TLS=true
KAYAK_SMTP_USERNAME=your-email@example.com
KAYAK_SMTP_PASSWORD=your-email-app-password
